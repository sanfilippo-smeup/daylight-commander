/* File types tab (DC-034): title, summary cards and one bar chart.
   Colors arrive as $name variables from daylight.themes.get_css_variables();
   no color literal here. Summary cards and the chart are shared components, so
   their box styling lives with the Stats tab in stats.tcss. */

#filetypes-page {
    height: 1fr;
    padding: 0 1;
}

#filetypes-title {
    height: 1;
    color: $accent;
    background: $surface;
    padding: 0 1;
    text-style: bold;
}

#filetypes-scroll {
    height: 1fr;
}
