/* Dashboard page (DC-030): spec-driven AI dashboards. Colors arrive as $name
   variables from daylight.themes.get_css_variables(); no color literal here. */

#dashboard-page {
    height: 1fr;
    padding: 0 1;
}

#dashboard-title {
    height: 1;
    color: $accent;
    background: $surface;
    padding: 0 1;
    text-style: bold;
}

#dashboard-blocks {
    height: auto;
}

.dashboard-block {
    width: 1fr;
    height: auto;
    background: $panel;
    border: round $secondary;
    padding: 0 1;
}

.dashboard-summary {
    height: auto;
}

.dashboard-empty {
    color: $muted;
    height: auto;
    padding: 1 1;
}